flowchart TD
    Start((Bắt đầu)) --> DoctorStart

    subgraph DoctorLane["Bác sĩ"]
        DoctorStart[Tiếp nhận lượt khám]
        OrderTests[Chỉ định dịch vụ cận lâm sàng]
        ReviewResults[Xem kết quả và kết luận chẩn đoán]
    end

    subgraph EmrLane["Hệ thống EMR"]
        CreateRecord[Tạo hoặc cập nhật hồ sơ khám<br/>Booking: IN_PROGRESS; Record: WAITING]
        SaveOrders[Lưu MedicalTest: WAITING<br/>Record: IN_TESTING]
        CheckPayment{Đủ điều kiện thanh toán?}
        SaveResult[Lưu kết quả và thông báo bệnh nhân<br/>MedicalTest: COMPLETED]
        AllDone{Đã hoàn tất mọi chỉ định?}
        Diagnosing[Chuyển hồ sơ sang DIAGNOSING]
        PaymentBlocked[Trả lỗi 402<br/>chưa cho cập nhật kết quả]
    end

    subgraph LabLane["Kỹ thuật viên"]
        PerformTest[Thực hiện xét nghiệm / CĐHA]
        SubmitResult[Gửi kết quả xét nghiệm]
    end

    subgraph CashierLane["Thu ngân"]
        Pay[Hoàn tất khoản thanh toán còn thiếu]
    end

    DoctorStart --> CreateRecord --> OrderTests --> SaveOrders --> PerformTest --> SubmitResult --> CheckPayment
    CheckPayment -- Có: giao dịch đạt điều kiện hoặc lượt ưu tiên --> SaveResult
    CheckPayment -- Không --> PaymentBlocked --> Pay --> SubmitResult
    SaveResult --> AllDone
    AllDone -- Chưa --> PerformTest
    AllDone -- Rồi --> Diagnosing --> ReviewResults --> End((Kết thúc))

    classDef state fill:#eaf3f6,stroke:#2c7180,color:#17343d,stroke-width:1.5px;
    classDef decision fill:#fff3df,stroke:#d18b35,color:#573b16,stroke-width:1.5px;
    class CreateRecord,SaveOrders,SaveResult,Diagnosing,PaymentBlocked state;
    class CheckPayment,AllDone decision;
