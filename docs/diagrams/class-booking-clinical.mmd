classDiagram
    class PatientProfile {
        UUID patientProfileId
        String fullName
        String phoneNumber
        LocalDate dateOfBirth
    }
    class Doctor {
        UUID doctorId
        Degree degree
        BigDecimal consultationFee
    }
    class TimeSlot {
        UUID timeSlotId
        LocalTime startTime
        LocalTime endTime
        Integer maxCapacity
        Integer currentBookings
        Integer holdingCount
    }
    class Booking {
        UUID bookingId
        String bookingCode
        LocalDate bookingDate
        Integer queueNumber
        BookingStatus status
        BigDecimal price
    }
    class MedicalExaminationRecord {
        UUID recordId
        MedicalExamState state
        String symptoms
        String finalDiagnosis
        Boolean isLocked
    }
    class MedicalTest {
        UUID medicalTestId
        String testCode
        MedicalTestState state
        String testResult
    }
    class MedicalService {
        Integer serviceId
        String serviceName
        BigDecimal price
    }

    Booking "0..*" --> "1" PatientProfile : patientProfile
    Booking "0..*" --> "1" Doctor : doctor
    Booking "0..*" --> "1" TimeSlot : timeSlot
    MedicalExaminationRecord "0..1" --> "1" Booking : booking
    MedicalExaminationRecord "1" --> "0..*" MedicalTest : medicalTests
    MedicalTest "0..*" --> "1" MedicalService : medicalService
