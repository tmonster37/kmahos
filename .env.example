# ==============================================================================
# BỆNH VIỆN ĐA KHOA QUỐC TẾ TNT / KMA HOSPITAL MANAGEMENT SYSTEM (HMS)
# CẤU HÌNH MẪU MÔI TRƯỜNG (.env.example) - SAO CHÉP THÀNH .env KHI DEPLOY
# ==============================================================================

# 1. BẢO MẬT XÁC THỰC (JWT - 512-bit High Entropy Key)
# Lệnh sinh key an toàn: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_512_BIT_HEX_OR_BASE64_CRYPTOGRAPHIC_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# 2. GIỚI HẠN TÊN MIỀN TRUY CẬP (CORS STRICT WHITELIST)
CORS_ALLOWED_ORIGINS=https://hospital.kma.edu.vn,https://kiosk.hospital.kma.edu.vn,https://admin.hospital.kma.edu.vn

# 3. CƠ SỞ DỮ LIỆU POSTGRESQL
POSTGRES_DB=hospital_prod_db
POSTGRES_USER=hospital_app_user
POSTGRES_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_db:5432/hospital_prod_db
SPRING_DATASOURCE_USERNAME=hospital_app_user
SPRING_DATASOURCE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# 4. CỔNG THANH TOÁN VNPAY
VNPAY_TMN_CODE=YOUR_MERCHANT_TMN_CODE
VNPAY_HASH_SECRET=YOUR_MERCHANT_HASH_SECRET
VNPAY_PAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://hospital.kma.edu.vn/api/payment/vnpay/callback

# 5. CẤU HÌNH SAO LƯU DỮ LIỆU TỰ ĐỘNG
BACKUP_DIR=/var/backups/hospital_db
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE=0 2 * * *
